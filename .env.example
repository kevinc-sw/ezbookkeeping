# Copy to .env and set secrets before first run:
#   cp .env.example .env
#
# Generate a secret key with:
#   openssl rand -base64 32

# PostgreSQL
POSTGRES_DB=ezbookkeeping
POSTGRES_USER=ezbookkeeping
POSTGRES_PASSWORD=change_me

# ezBookkeeping (required)
EBK_SECURITY_SECRET_KEY=change_me_to_a_random_string

# Domain users will use to access the app (avatars, pictures, email links)
EBK_SERVER_DOMAIN=localhost
